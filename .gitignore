# Python
__pycache__/
*.py[cod]
.venv/

# Backups and scratch (never tracked)
*.bak*
*.pre-*
*.prewrite*
*.tmp
*.log

# Agent intermediates: only the batch files (validate needs them), the gap log, the agent briefs
# and the lead's small state/tool files are tracked
work/*
!work/batches/
!work/gaps.jsonl
!work/BRIEF_*.md
!work/lead/
work/lead/*
!work/lead/STATE.md
!work/lead/status.py
!work/lead/collect_fixes.py

